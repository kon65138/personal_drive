<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="css/style.css" />
    <link rel="stylesheet" href="css/index.css" />
    <style>
      body {
        background-image:
          url('<%= wallpaper.landscape %>'),
          url('<%= wallpaper.landscapeThumb %>');
        background-size: cover;
        background-position: center;
      }

      @media (orientation: portrait) {
        body {
          background-image:
            url('<%= wallpaper.portrait %>'),
            url('<%= wallpaper.portraitThumb %>');
        }
      }
    </style>
    <title>Personal Drive</title>
  </head>
  <body>
    <header>
      <h1 id="title">error</h1>
    </header>
    <div class="error">
      <span>Error<%= status %> : <% message %></span>
    </div>
  </body>
</html>
