<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/dashboard.css" />
    <script src="/js/pageTransition.js" defer></script>
    <script src="/js/dashboard.js" defer></script>
    <title>Personal Drive</title>
  </head>
  <body class="instant">
    <%- include('partials/title') %>
    <div class="container">
      
      <div class="bottom" data-no-transition>
        <div class="left">
          <div class="upload btns">
        <form
          action="/dashboard/newFile"
          method="post"
          id="uploadForm"
          enctype="multipart/form-data"
          data-no-transition
        >
          <input type="hidden" name="parentId" value="<%= locals.currentFolder ? currentFolder.id : '' %>" />
          <input type="file" name="file" id="upload" class="visuallyHidden" />
          <label for="upload" class="uploadButton">Upload file</label>

          <input type="file" name="file" id="uploadFolder" class="visuallyHidden" webkitdirectory multiple />
          <label for="uploadFolder" class="uploadButton">Upload folder</label>
        </form>
      </div>
          <div class="folderBar">
          <h2 class="folderTitle">folders</h2>
          <div class="folderList">

          <div
  id="rootFolder"
  class="folder"
  data-id="<%= rootFolder.id %>"
  data-updated="<%= formatDate(rootFolder.updatedAt) %>"
  data-added="<%= formatDate(rootFolder.createdAt) %>"
  data-items="<%= rootFolder._count.children + rootFolder._count.files %>"
>
  <a class="name" href="/dashboard">Root</a>
</div>


          <% if (locals.currentFolder && currentFolder.parentId) { %>
            <div class="folder navUp">
              <a class="name" href="/dashboard/folders/<%= currentFolder.parentId %>">.. previous folder</a>
            </div>
          <% } %>

          <template id="folderRowTemplate">
            <div class="folder" data-id="">
              <a class="name"></a>
            </div>
          </template>

          <% if (locals.currentFolders && currentFolders.length) { %>
            <% currentFolders.forEach((folder) => { %>
              <div class="folder" data-id="<%= folder.id %>" data-updated="<%= formatDate(folder.updatedAt) %>" data-added="<%= formatDate(folder.createdAt) %>" data-items="<%= folder._count.children + folder._count.files %>">
                <a class="name" href="/dashboard/folders/<%= folder.id %>"><%= folder.name %></a>
              </div>
            <% })} %>
            <div class="newFolderContainer">
              <form action="/dashboard/newEmptyFolder" method="post" id="newFolderForm">
              <input type="hidden" name="parentId" value="<%= locals.currentFolder ? currentFolder.id : '' %>">
              <input type="text" id="newFolderInput" name="newFolder" placeholder="enter folder name" required>
            </form>
            </div>
          <button id="addFolderBtn">+</button>
          </div>
        </div></div>
        
        
        <div class="fileExplorer">
          <div class="fileExplorerHeader">
            <div class="name">name</div>
            <div>|</div>
            <div class="size">size</div>
            <div>|</div>
            <div class="dateAdded"> date added</div>
          </div>
          <div class="fileList">
          <template id="fileRowTemplate">
            <a class="fileRow" download>
              <div class="name"></div>
              <div>|</div>
              <div class="size"></div>
              <div>|</div>
              <div class="dateAdded"></div>
            </a>
          </template>
          <% if (locals.currentFolderContent && currentFolderContent.length) { %>
            <% currentFolderContent.forEach((file) => { %>
              <a
                class="fileRow"
                href="/dashboard/files/<%= file.id %>"
                data-id="<%= file.id %>"
                data-type="<%= file.mimeType %>"
                data-updated="<%= formatDate(file.updatedAt) %>"
                download
              >
                <div class="name"><%= file.name %></div>
                <div>|</div>
                <div class="size"><%= formatBytes(file.size) %></div>
                <div>|</div>
                <div class="dateAdded"><%= formatDate(file.createdAt) %></div>
              </a>
            <% }) %>
          <% } else { %>
            <p class="emptyExplorer">This folder is empty</p>
          <% } %>
          </div>
        </div>
        <div class="rightSidebar">
          <div class="helpAndLogoutBtns">
            <button id="help" data-popup="helpPanel" aria-expanded="false">Help</button>
            <a id="logout" href="/logout">Logout</a>
          </div>
          <div class="storageMeter">
            <div class="meter">
              <div class="meterUsed"></div>
              <div class="meterLeft"></div>
            </div>
            <div class="storageStats">
              <div class="totalSpace">Total Space: <%= locals.storageSize %></div>
              <div class="storageUsed"></div>
              <div class="storageLeft"></div>
            </div>
          </div>
          <div class="selectedDetails">
            <div class="details">
              <label>Name</label>
              <div class="name"></div>
              <label>Type</label>
              <div class="type"></div>
              <label>Size</label>
              <div class="size"></div>
              <label>Last Updated</label>
              <div class="updatedAt"></div>
              <label>Date Added</label>
              <div class="dateAdded"></div>
              <label class="items" style="display: none;">Items</label>
              <div class="items" style="display: none;"></div>
            </div>
            <div class="buttons">
              <button id="share" data-popup="sharePopup" aria-expanded="false" disabled>Share</button>
              <button id="rename" disabled>Rename</button>
              <button id="delete" disabled>Delete</button>
            </div>
          </div>
        </div>
        
      </div>
    </div>
    <div id="progressBar">
      <div>progress</div>
      <div class="message"></div>
      <div class="bar">
        <div class="barInside"></div>
      </div>
      <div class="error"></div>
      <div class="bottom">
        <div class="success">Success: 0</div>
        <div class="failure">failure: 0</div>
        <button id="stopUpload" type="button">Stop</button>
      </div>
    </div>
    <div class="popup help" id="helpPanel">
      <h3>Help</h3>
      <div>Single click to select a file or folder, double click or click while selected to download a file.</div>
      <div>Navigate through folders in your current directory by using the folder bar, double click to navigate.</div>
      <div>The upload buttons will place the uploaded file or folder in the current directory.</div>
      <div>When renamaming hit enter to submit or click away or esc to cancel.</div>
      <div>You cannot rename or delete Root.</div>
    </div>
    <div class="popup" id="sharePopup">
      <h3>Share</h3>
      <div>Generate a link to share </div>
      <form id="shareForm" action="">
        <label for="duration">How log should the link be online?</label>
        <select name="duration" id="duration">
          <option value="1h">1 hour</option>
          <option value="3h">3 hours</option>
          <option value="12h">12 hours</option>
          <option value="1d">1 day</option>
          <option value="1w">1 week</option>
          <option value="1m">1 month</option>
        </select>
        <button id="generate">Generate link</button>
      </form>
      <div class="link"></div>
    </div>
  </body>
</html>
