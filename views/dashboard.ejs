<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/dashboard.css" />
    <script src="/js/pageTransition.js" defer></script>
    <script src="/js/dashboard.js" defer></script>
    <title>Personal Drive</title>
  </head>
  <!-- browsing between folders reloads this page; fading in each time would
       make navigation feel slow -->
  <body class="instant">
    <%- include('partials/title') %>
    <div class="container">
      <div class="top">
        <form
          action="/dashboard/newFile"
          method="post"
          id="uploadForm"
          enctype="multipart/form-data"
          data-no-transition
        >
          <input type="hidden" name="parentId" value="<%= locals.currentFolder ? currentFolder.id : '' %>" />
          <input type="file" name="file" id="upload" class="visuallyHidden" />
          <label for="upload" class="uploadButton">Upload file</label>
        </form>

        <div class="searchBar">
          <input
            type="text"
            id="search"
            placeholder="search for file or folder"
          />
        </div>
        <button id="settings">settings</button>
      </div>
      <!-- browsing and CRUD inside the drive stay instant; only page-level
           links (the title, login, etc.) get the fade -->
      <div class="bottom" data-no-transition>
        <div class="folderBar">
          <h2 class="folderTitle">folders</h2>

          <div id="rootFolder" class="folder">
            <a class="name" href="/dashboard">Root</a>
            <%- include('partials/folderOptions') %>
          </div>

          <% if (locals.currentFolder && currentFolder.parentId) { %>
            <div class="folder">
              <a class="name" href="/dashboard/folders/<%= currentFolder.parentId %>">.. previous folder</a>
            </div>
          <% } %>

          <template id="folderRowTemplate">
            <div class="folder" data-id="">
              <a class="name"></a>
              <%- include('partials/folderOptions') %>
            </div>
          </template>

          <% if (locals.currentFolders && currentFolders.length) { %>
            <% currentFolders.forEach((folder) => { %>
              <div class="folder" data-id="<%= folder.id %>">
                <a class="name" href="/dashboard/folders/<%= folder.id %>"><%= folder.name %></a>
                <%- include('partials/folderOptions') %>
              </div>
            <% })} %>
            <div class="newFolderContainer">
              <form action="/dashboard/newEmptyFolder" method="post" id="newFolderForm">
              <input type="hidden" name="parentId" value="<%= locals.currentFolder ? currentFolder.id : '' %>">
              <input type="text" id="newFolderInput" name="newFolder" placeholder="enter folder name" required>
            </form>
            </div>
          <button id="addFolderBtn">+</button>
        </div>
        <div class="fileExplorer">
          <div class="fileExplorerHeader">
            <div class="name">name</div>
            <div>|</div>
            <div class="size">size</div>
            <div>|</div>
            <div class="dateAdded"> date added</div>
          </div>
          <template id="fileRowTemplate">
            <a class="fileRow" download>
              <div class="name"></div>
              <div>|</div>
              <div class="size"></div>
              <div>|</div>
              <div class="dateAdded"></div>
            </a>
          </template>
          <% if (locals.currentFolderContent && currentFolderContent.length) { %>
            <% currentFolderContent.forEach((file) => { %>
              <a
                class="fileRow"
                href="/dashboard/files/<%= file.id %>"
                data-id="<%= file.id %>"
                download
              >
                <div class="name"><%= file.name %></div>
                <div>|</div>
                <div class="size"><%= formatBytes(file.size) %></div>
                <div>|</div>
                <div class="dateAdded"><%= formatDate(file.createdAt) %></div>
              </a>
            <% }) %>
          <% } else { %>
            <p class="emptyExplorer">This folder is empty</p>
          <% } %>
        </div>
        <div class="rightSidebar">
          <div class="storageMeter">Meter</div>
          <div class="selectedDetails">folder or file details go here along with CRUD btns</div>
        </div>
        
      </div>
    </div>
  </body>
</html>
