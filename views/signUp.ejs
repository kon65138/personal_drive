<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="css/style.css" />
    <link rel="stylesheet" href="css/signUp.css" />
    <title>Personal Drive</title>
  </head>
  <body>
    <header>
      <a href="/"><h1 id="title">Personal Drive</h1></a>
    </header>
    <div class="loginContainer">
      <form method="post" id="signUpForm">
        <div class="firstName">
          <label for="firstName">first Name:</label>
          <input type="text" name="firstName" id="firstName" value="<%= values ? values.firstName : '' %>" required />
        </div>
        <div class="username">
          <label for="username">username:</label>
          <input type="text" name="username" id="username" value="<%= values ? values.username : '' %>" required />
        </div>
        <div class="password">
          <label for="password">password:</label>
          <input type="password" name="password" id="password" required />
        </div>
        <div class="confirmPassword">
          <label for="confirmPassword">confirm password:</label>
          <input
            type="password"
            name="confirmPassword"
            id="confirmPassword"
            required
          />
        </div>
        <span class="errorList">
          <ul>
            <% if (errors) {errors.forEach( error => { %>
                    <li><%= error.msg %></li>
            <% })} %>
          </ul>
        </span>
        <button type="submit">Sign Up</button>
      </form>
    </div>
  </body>
</html>
