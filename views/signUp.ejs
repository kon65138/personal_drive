<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="css/style.css" />
    <link rel="stylesheet" href="css/signUp.css" />
    <script src="/js/pageTransition.js" defer></script>
    <title>Personal Drive</title>
  </head>
  <body>
    <div class="left">
    <%- include('partials/title') %>
    <div class="signUpContainer">
      <h2>Welcome to Rooms</h2>
      <form method="post" id="signUpForm">
        <div class="firstName">
          <input type="text" name="firstName" id="firstName" value="<%= values ? values.firstName : '' %>" placeholder="Enter first name" required />
        </div>
        <div class="username">
          <input type="text" name="username" id="username" value="<%= values ? values.username : '' %>" placeholder="Enter username or email" required />
        </div>
        <div class="password">
          <input type="password" name="password" id="password" placeholder="Enter password" required />
        </div>
        <div class="confirmPassword">
          <input
            type="password"
            name="confirmPassword"
            id="confirmPassword"
            placeholder="Enter password again"
            required
          />
        </div>
        <span class="errorList">
          <ul>
            <% if (errors) {errors.forEach( error => { %>
                    <li><%= error.msg %></li>
            <% })} %>
          </ul>
        </span>
        <button type="submit">Sign Up</button>
      </form>
    </div></div>
    <div class="right"></div>
    
  </body>
</html>
